<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anders_2.Views.MobileView"
              Margin="0,0,0,-30"
             Padding="0.5,2,0,2"
             BackgroundColor="#121212">
    <Grid>
        <AbsoluteLayout>
            <AbsoluteLayout.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </AbsoluteLayout.GestureRecognizers>
            <HorizontalStackLayout
                        HorizontalOptions="Center"
                            Padding="102,20"
                            Margin="0,10">
                <Button
                            Text=""
                            Padding="10,2"
                            WidthRequest="1"
                             Scale="0.8"
                            HeightRequest="1"
                             />
                <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                Scale="0.8" />
                <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                 Scale="0.8"/>
                <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                 Scale="0.8"/>
            </HorizontalStackLayout>
        </AbsoluteLayout>
            <Grid
                RowDefinitions="20,*"
                ColumnDefinitions="200,*">
                <Grid
                    Grid.Row="0">
                         <Grid>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                            Padding="102,20"
                            Margin="0,10">
                            <Button
                            Text=""
                            Padding="10,2"
                            WidthRequest="1"
                             Scale="0.8"
                            HeightRequest="1"
                             />
                            <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                Scale="0.8" />
                            <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                 Scale="0.8"/>
                            <Button
                            Text=""
                            Padding="10,2"
                                WidthRequest="1"
                                HeightRequest="1"
                                 Scale="0.8"/>
                        </HorizontalStackLayout>
                        </Grid>
                    
                </Grid>
            <VerticalStackLayout
                        Scale="0.1"
                       HorizontalOptions="End"
                         Grid.Column="1">
                <ImageButton
                        Source="acadmicpic.jpg"
                        BackgroundColor="AliceBlue"
                            />

            </VerticalStackLayout>

        </Grid>
        <Grid
          x:Name="MainContentContainer">
            <Border
                Padding="16"
                Margin="10,60,10,10"
                StrokeShape="RoundRectangle 25,25,0,0"
                ></Border>
        </Grid>
        <!--bottom tab bar-->
        <Border
            VerticalOptions="End"
            WidthRequest="365"
            StrokeShape="RoundRectangle 25,25,0,0"
            Padding="1"
            Background="#121212">
            <HorizontalStackLayout
                Spacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="10,0,0,0"
                Padding="0,15,10,40">
                <Button
                        Text=""
                        Padding="10,2"
                        WidthRequest="20"
                        HeightRequest="20"
                         />
                <Button
                        Text=""
                        Padding="10,2"/>
                <Button
                        Text=""
                        Padding="10,2"/>
                <Button
                        Text=""
                        Padding="10,2"/>
            </HorizontalStackLayout>

        </Border>
    </Grid>
</ContentView>
